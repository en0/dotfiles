#!/bin/bash
# todo-categorize — assign due dates to newly-captured todos via the
# todo-categorizer agent. Meant for cron on a short tumbling window.
#
# Cheap guard first: only invoke the model when the NEW bucket is non-empty, so
# an idle window costs nothing.

set -uo pipefail

# Cron/systemd start with a minimal PATH; add the usual bin dirs so kiro-cli
# resolves wherever it is installed on this host (system or user-local).
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

TODO="$HOME/.bin/todo"

# Nothing captured since last run -> exit before spending a model call.
[[ -z "$("$TODO" list --filter new -q)" ]] && exit 0

# No --trust-all-tools on purpose: that would override the agent's
# allowedCommands allowlist. Instead the agent auto-approves only the exact
# todo commands in its config; anything else fails closed in headless mode.
exec kiro-cli chat \
  --agent todo-categorizer \
  --no-interactive \
  "Categorize new todo items now."
