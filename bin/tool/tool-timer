#!/bin/bash

### tool-timer ####################################################################################
# A count-down timer that will display in your notification system and play an alarm once done.
# Anchored to an absolute deadline, so notification latency does not cause drift.
# Dependencies: notify-send
###################################################################################################

source $(dirname $(readlink -e $0))/helpers

NAME="Timer"
N_TOOL_TIMER=$((N_TOOL_TIMER + (1 + RANDOM % 100000)))

# Bundled alarm sound, shipped in the repo so it works on every machine
# regardless of what system sound themes are installed.
ALARM_SOUND="$(dirname $(readlink -e $0))/assets/timer-alarm.wav"

function show() {
    r=$(format-time $1)
    [ $1 -eq 0 ] && u="critical" x="Times Up!" || u="normal"
    notify-send -u $u -r $N_TOOL_TIMER "󰔟 $2 $r" "$x"
}

function launch-tool() {

    local t_hours t_minutes t_seconds t_label t_dur

    t_hours=0
    t_minutes=0
    t_seconds=0

    # Prompt for the timer and extract all the parts
    t_dur="$(dmenu -p "󰔟 ${NAME} (0h 0m 0s):" $@ </dev/null)"
    [[ $t_dur =~ ([0-9]+)h ]] && t_hours=${BASH_REMATCH[1]}
    [[ $t_dur =~ ([0-9]+)m ]] && t_minutes=${BASH_REMATCH[1]}
    [[ $t_dur =~ ([0-9]+)s ]] && t_seconds=${BASH_REMATCH[1]}
    [[ $t_dur =~ \[([^$]+)\] ]] && t_label="${BASH_REMATCH[1]}"
    [[ "$t_label" == "" ]] && t_label="$NAME"

    # Check for kill command
    if [[ "${t_dur,,}" =~ ^(cancel|kill|stop) ]]; then
        pid=$(pgrep -f "tool-timer execute $t_label")
        [ $? -eq 0 ] && \
            kill $pid && \
            notify-send "󰔟 Cancel Timer" "$t_label cancled." || \
            notify-send -u "critical" "󰔟 Cancel Timer" "Unable to find timer."
    else
        # Relaunch with the label so we can kill it later
        $0 execute "$t_label" $t_hours $t_minutes $t_seconds
    fi
}

function exec-tool() {
    local t_label t_seconds deadline now remaining

    t_label="$2"
    t_seconds=$(($5 + ($4 * 60) + ($3 * 3600)))

    # Anchor to an absolute deadline so drift can't accumulate: each tick
    # derives the remaining time from the wall clock rather than assuming
    # every loop iteration took exactly one second. notify-send latency and
    # scheduling jitter no longer push the finish time out.
    deadline=$(( $(date +%s) + t_seconds ))

    while :; do
        now=$(date +%s)
        remaining=$(( deadline - now ))
        (( remaining < 0 )) && remaining=0

        show "$remaining" "$t_label"
        if (( remaining == 0 )); then
            play-sound "$ALARM_SOUND"
            break
        fi

        # Sleep to the next whole-second boundary (not a flat 1s) so the
        # displayed value tracks real seconds and never skips or repeats.
        # Sleep the leftover of the current second, plus a few ms so we wake
        # just past the boundary instead of landing exactly on it.
        ms=$(( (10#$(date +%N) / 1000000) % 1000 ))
        sleep "$(printf '0.%03d' $(( 1005 - ms )))" 2>/dev/null || sleep 1
    done
}

case "$1" in
execute)
    exec-tool "$@";;
*)
    launch-tool "$@";;
esac
