#!/bin/bash

### tool-stopwatch ################################################################################
# A stopwatch timer.
# Anchored to the wall clock, so notification latency does not cause drift.
# Dependencies: dmenu, notify-send.
###################################################################################################

source $(dirname $(readlink -e $0))/helpers

NAME=" Stopwatch"

# Signals for IPC
SIG_PAUSE="SIGUSR1"
SIG_LAP="SIGUSR2"
SIG_STOP="SIGABRT" # since the subprocess has not tty, cant use sigint

# Timer state. Elapsed time is derived from the wall clock rather than counted,
# so it can't drift. ACCUMULATED holds seconds banked before the current running
# segment; SEGMENT_START is the epoch second the current segment began (unused
# while paused). Running elapsed = ACCUMULATED + (now - SEGMENT_START).
IS_PAUSED=0
ACCUMULATED=0
SEGMENT_START=$(date +%s)
TIMER_VALUE=0
LAPS=()

function install-traps() {
    trap toggle-pause $SIG_PAUSE
    trap mark-lap $SIG_LAP
}

# elapsed - Print the current elapsed whole seconds, accounting for pauses.
function elapsed() {
    if [[ $IS_PAUSED -eq 1 ]]; then
        echo "$ACCUMULATED"
    else
        echo $(( ACCUMULATED + ($(date +%s) - SEGMENT_START) ))
    fi
}

function toggle-pause() {
    if [[ $IS_PAUSED -eq 0 ]]; then
        # Bank the running segment, then stop the clock.
        ACCUMULATED=$(( ACCUMULATED + ($(date +%s) - SEGMENT_START) ))
        IS_PAUSED=1
    else
        # Resume: start a fresh segment from now.
        SEGMENT_START=$(date +%s)
        IS_PAUSED=0
    fi
}

function mark-lap() {
    LAPS+=($(elapsed))
}

function show() {
    local m laps
    [ $IS_PAUSED -eq 1 ] && m=" (Paused)"
    laps=$(for i in "${!LAPS[@]}"; do
        li=$((i + 1))
        echo "Lap $li: $(format-time ${LAPS[$i]})"
    done)
    notify-send -r $N_TOOL_STOPWATCH "$NAME $(format-time $TIMER_VALUE)$m" "$laps"
}

function launch-tool() {

    # If the timer is not running, start it and exit.
    local pid actions
    pid=$(pgrep -f "tool-stopwatch execute")
    if [ ! $? -eq 0 ]; then
        $0 execute &
        exit
    fi

    # otherwise, show the options. If no action was selected, do nothing.
    action=$(echo -e "Pause\nLap\nClear" | dmenu -i -p "${NAME}:" $@)
    [[ "$action" == "" ]] && exit

    # Send signal to the timer
    case "$action" in
    Pause)
        kill -s $SIG_PAUSE $pid ;;
    Lap)
        kill -s $SIG_LAP $pid ;;
    Clear)
        kill -s $SIG_STOP $pid ;;
    esac
}

function exec-tool() {
    local ms
    install-traps
    while true; do
        TIMER_VALUE=$(elapsed)
        show

        # Sleep to the next whole-second boundary (not a flat 1s) so the
        # display tracks real seconds regardless of notify-send latency. A
        # pause/lap signal interrupts the sleep and re-renders immediately.
        ms=$(( (10#$(date +%N) / 1000000) % 1000 ))
        sleep "$(printf '0.%03d' $(( 1005 - ms )))" 2>/dev/null || sleep 1
    done
}

case "$1" in
execute)
    exec-tool "$@";;
*)
    launch-tool "$@";;
esac
